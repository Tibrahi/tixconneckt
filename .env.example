# Realtime (standalone Socket.IO server, see realtime.mjs).
# NEXT_PUBLIC_REALTIME_URL is the browser-facing socket URL; leave blank for
# same-host localhost development (http://localhost:3001).
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=
# Shared secret between Next.js API routes and the realtime relay endpoint.
INTERNAL_RELAY_SECRET=

# Optional override for WebRTC call connectivity (comma-separated STUN URLs).
# Defaults to a free public STUN server when blank.
NEXT_PUBLIC_STUN_URLS=
# Optional TURN relay for restrictive networks (symmetric NAT). Without it,
# some networks cannot establish peer media and calls fail honestly.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=
